# Шаблон переменных окружения. Скопируй в .env (для docker compose) или .env.local
# (для локального pnpm dev) и заполни. Все переменные валидируются через Zod в lib/env.ts.
#
# Минимум для локального dev:
#   1) docker compose up -d postgres
#   2) cp .env.example .env.local
#   3) DATABASE_URL=postgresql://infoscan:devpass@localhost:5432/infoscan
#   4) NEXTAUTH_SECRET=$(openssl rand -base64 32)
#   5) ADMIN_PASSWORD задай любой
#   6) pnpm dev

# ---- Публичные (NEXT_PUBLIC_*) ----

# Базовый URL сайта (для канонических ссылок, sitemap, OG-картинок).
# На VPS с подпутём: http://178.72.170.189/infoscan_tst
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Аналитика. По умолчанию off (Plausible / Umami self-hosted, без cookies).
NEXT_PUBLIC_ANALYTICS=off
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# DSN для Sentry (опционально). Если пусто — captureError пишет в console.
NEXT_PUBLIC_SENTRY_DSN=

# ---- Серверные ----

# Postgres
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgresql://infoscan:devpass@localhost:5432/infoscan

# Auth.js (next-auth v5)
# На VPS с подпутём: NEXTAUTH_URL=http://178.72.170.189/infoscan_tst
NEXTAUTH_URL=http://localhost:3000
# Сгенерируй: openssl rand -base64 32
NEXTAUTH_SECRET=

# Первый ADMIN — создаётся seed-скриптом, если БД пустая.
# Смени пароль через UI после первого логина.
ADMIN_EMAIL=admin@inf-tec.ru
ADMIN_PASSWORD=ChangeMe!12345

# Git-sync (бэкап БД в репо по кнопке)
GIT_REPO_URL=git@github.com:Probrokker/infoscan_tst.git
GIT_BRANCH=main

# Бэкапы Postgres (контейнер backup)
BACKUP_RETENTION_DAYS=14

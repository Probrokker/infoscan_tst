# Шаблон переменных окружения. Скопируй в .env.local и заполни.
# Все переменные валидируются через Zod в lib/env.ts при старте.

# Базовый URL сайта (нужен для канонических ссылок, sitemap, OG-картинок).
NEXT_PUBLIC_SITE_URL=https://docs.inf-tec.ru

# Включить/выключить аналитику. По умолчанию off.
# Если on — используется Plausible / Umami (self-hosted, без cookies).
NEXT_PUBLIC_ANALYTICS=off
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# DSN для Sentry (опционально). Если пусто — captureError пишет в console.
NEXT_PUBLIC_SENTRY_DSN=

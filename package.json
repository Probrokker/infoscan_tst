{
  "name": "infoscan-docs",
  "version": "0.1.0",
  "private": true,
  "description": "База знаний «Инфоскан» — документация и интерактивные инструменты (конструктор JS-шаблона + эмулятор устройства)",
  "license": "UNLICENSED",
  "author": {
    "name": "ООО «Инфотех»",
    "email": "sales@inf-tec.ru",
    "url": "https://inf-tec.ru"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm postbuild",
    "postbuild": "tsx scripts/build-search.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "lint:fix": "eslint . --fix --no-warn-ignored",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,mdx,css}\"",
    "stylelint": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "size": "size-limit",
    "analyze": "ANALYZE=true next build",
    "audit": "pnpm audit --audit-level=high",
    "gitleaks": "gitleaks detect --source . --no-banner",
    "a11y": "pa11y-ci",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2",
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^8",
    "@hookform/resolvers": "^3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.0.3",
    "@prisma/client": "^5",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5",
    "@theguild/remark-mermaid": "^0.2.0",
    "@uiw/react-codemirror": "^4",
    "@vercel/og": "^0.6.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1",
    "dompurify": "^3.2.1",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "next": "^15.0.3",
    "next-auth": "5.0.0-beta.21",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.33",
    "shiki": "^1.22.2",
    "simple-git": "^3",
    "slugify": "^1.6",
    "sonner": "^1.5",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/eslintrc": "^3.1.0",
    "@next/bundle-analyzer": "^15.0.3",
    "@playwright/test": "^1.48.2",
    "@size-limit/preset-app": "^11.1.6",
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "axe-core": "^4.10.2",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "pa11y-ci": "^3.1.0",
    "pagefind": "^1.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^5",
    "size-limit": "^11.1.6",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^4.0.0-beta.4",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "size-limit": [
    {
      "name": "Главная страница (первичный JS)",
      "path": ".next/static/chunks/app/page-*.js",
      "limit": "130 KB",
      "gzip": true
    },
    {
      "name": "Страница статьи (первичный JS)",
      "path": ".next/static/chunks/app/[[]...slug]/page-*.js",
      "limit": "100 KB",
      "gzip": true
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,mdx,css}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}

// Prisma schema для админ-панели Инфоскан.
// БД — Postgres 16. Источник правды для контента и пользователей.
// Auth.js v5 модели (Session/Account/VerificationToken) живут здесь же.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum Role {
  ADMIN
  EDITOR
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// «ADMIN_AUDIENCE» — чтобы не пересекаться с Role.ADMIN.
enum Audience {
  OPERATOR
  ADMIN_AUDIENCE
  DEVELOPER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGE
  CREATE
  UPDATE
  DELETE
  PUBLISH
  ARCHIVE
  GIT_SYNC
  USER_CREATE
  USER_UPDATE
  USER_DEACTIVATE
}

// ---- Пользователи и сессии ----

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles  Article[]
  versions  ArticleVersion[]
  auditLogs AuditLog[]
  sessions  Session[]
  accounts  Account[]
  assets    Asset[]

  @@index([isActive])
}

// Auth.js v5 модели — DB-сессии через Prisma adapter.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Контент ----

model Section {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  order       Int      @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([order])
}

model Article {
  id             String        @id @default(cuid())
  sectionId      String
  slug           String
  title          String
  description    String
  body           String        @db.Text
  audience       Audience[]
  order          Int
  status         ArticleStatus @default(DRAFT)
  readingMinutes Int           @default(3)
  related        String[]
  authorId       String?
  // Soft-delete для toast-undo. Реальное удаление — фоном после 5s.
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?

  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions ArticleVersion[]

  @@unique([sectionId, slug])
  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  version   Int
  // Snapshot полей статьи на момент сохранения (для отката):
  // { title, description, body, audience, order, status, related }
  snapshot  Json
  authorId  String?
  comment   String?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([articleId, version])
}

// ---- Справочники ----

model DeviceModel {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  description String?
  order       Int      @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FirmwareVersion {
  id          String    @id @default(cuid())
  slug        String    @unique
  displayName String
  releaseDate DateTime?
  notes       String?
  order       Int       @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TemplateVariable {
  id          String   @id @default(cuid())
  key         String   @unique
  type        String
  displayName String
  description String?
  example     String?
  order       Int      @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Учебные дорожки и FAQ ----

model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  order       Int      @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps LearningPathStep[]
}

model LearningPathStep {
  id          String  @id @default(cuid())
  pathId      String
  articleSlug String
  order       Int
  notes       String?

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, order])
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  category    String?
  order       Int
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, order])
}

// ---- Asset (картинки в редакторе) ----

model Asset {
  id           String   @id @default(cuid())
  filename     String
  storedPath   String   @unique
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
}

// ---- Журнал и git-sync ----

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  ip         String?
  details    Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model GitSyncRun {
  id           String   @id @default(cuid())
  status       String // success | failure
  commitSha    String?
  message      String?
  filesChanged Int      @default(0)
  durationMs   Int
  triggeredBy  String? // userId
  errorText    String?
  createdAt    DateTime @default(now())
}
